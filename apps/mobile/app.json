{
  "expo": {
    "name": "TumaPesa",
    "slug": "tumapesa",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.tumapesa",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00A651"
      },
      "package": "com.example.tumapesa",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00A651"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to upload identity documents.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to capture your identity documents."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to sign you in."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aad42775-58aa-45d7-ba54-070c26b03596"
      }
    },
    "owner": "landrik"
  }
}
